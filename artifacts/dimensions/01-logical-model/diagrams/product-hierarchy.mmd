        PI1["ProductInstance<br/>PROD-010 DDA (CAD)"]
        PI2["ProductInstance<br/>PROD-010 DDA (USD)"]
        PI3["ProductInstance<br/>Multi-Currency Pool"]
        PI4["ProductInstance<br/>Intraday Sweep"]
        PI5["ProductInstance<br/>Balance Reporting"]

